APP_NAME=Lean Agent Builder API
APP_DEBUG=false
API_V1_PREFIX=/api/v1

# Prefer the direct database host for long-lived backends when your host supports IPv6.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# If your backend host is IPv4-only, use the Supavisor session pooler instead.
# DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

SCHEMA_MANAGEMENT_MODE=alembic
CORS_ORIGINS=["https://leanagentbuilder.com","https://www.leanagentbuilder.com"]
COMMERCE_PUBLIC_BASE_URL=https://leanagentbuilder.com

LLM_PROVIDER=openai
LLM_MODE=hybrid
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

LOCAL_ADMIN_EMAIL=lmcorredor@leanagentbuilder.com
LOCAL_ADMIN_PASSWORD=LeanBuilder123!
LOCAL_ADMIN_NAME=Lean Builder Admin
AUTH_TOKEN_TTL_HOURS=12
