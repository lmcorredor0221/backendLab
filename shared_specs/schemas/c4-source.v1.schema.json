{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-agent-builder.local/schemas/c4-source.v1.schema.json",
  "title": "C4 Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_key", "level", "source", "traceability_refs"],
  "properties": {
    "schema_version": { "const": "c4-source.v1" },
    "diagram_key": { "type": "string", "minLength": 1 },
    "level": { "enum": ["context", "container", "component", "code"] },
    "source": { "type": "string", "minLength": 1 },
    "traceability_refs": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  }
}
