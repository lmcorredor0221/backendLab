        },
        "product": {
          "default": "",
          "title": "Product",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "CommercialAuditFunnelStep",
      "type": "object"
    },
    "CommercialAuditMetric": {
      "additionalProperties": false,
