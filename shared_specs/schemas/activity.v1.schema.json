        "currency": {
          "default": "",
          "title": "Currency",
          "type": "string"
        },
        "key": {
          "default": "",
          "title": "Key",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
