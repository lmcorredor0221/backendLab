        "revenue_cents": {
          "default": 0,
          "title": "Revenue Cents",
          "type": "integer"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "",
          "title": "Status",
          "type": "string"
