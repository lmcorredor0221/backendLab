{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-agent-builder.local/schemas/bpmn-source.v1.schema.json",
  "title": "BPMN Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_key", "standard", "xml", "traceability_refs"],
  "properties": {
    "schema_version": { "const": "bpmn-source.v1" },
    "diagram_key": { "type": "string", "minLength": 1 },
    "standard": { "const": "BPMN 2.0" },
    "xml": { "type": "string", "pattern": "<(?:bpmn:)?definitions[\\s\\S]*</(?:bpmn:)?definitions>" },
    "traceability_refs": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  }
}
