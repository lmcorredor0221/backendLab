{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-agent-builder.local/schemas/diagram-model.v1.schema.json",
  "title": "DiagramModel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_key", "title", "notation", "direction", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": "diagram-model.v1" },
    "diagram_key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "notation": { "enum": ["flowchart", "sequence", "class", "er", "state", "journey", "c4", "bpmn", "uml_use_case", "uml_activity", "uml_component", "deployment", "package", "capability"] },
    "direction": { "enum": ["TB", "TD", "BT", "RL", "LR"] },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "legend": { "type": "array", "items": { "type": "object" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "description": { "type": "string" },
        "group_id": { "type": ["string", "null"] },
        "metadata": { "type": "object" },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "type": "string" }, "source": { "type": "string" }, "target": { "type": "string" },
        "label": { "type": "string" }, "kind": { "type": "string" }, "order": { "type": ["integer", "null"] },
        "metadata": { "type": "object" }, "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "label"],
      "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "kind": { "type": "string" }, "parent_id": { "type": ["string", "null"] }, "description": { "type": "string" } }
    }
  }
}
