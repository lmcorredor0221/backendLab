      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CanonicalProvenanceEntry"
      },
      "title": "Provenance",
      "type": "array"
    },
    "recommended_prompts": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Prompts",
      "type": "array"
    },
    "review_notes": {
      "items": {
        "type": "string"
      },
      "title": "Review Notes",
      "type": "array"
    },
    "schema_version": {
      "const": "heuristic-decision.v1",
      "default": "heuristic-decision.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_blueprint_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Blueprint Version"
    },
    "source_session_id": {
      "format": "uuid",
      "title": "Source Session Id",
      "type": "string"
    }
  },
  "required": [
    "source_session_id",
    "generated_at",
    "decision_summary"
  ],
  "title": "HeuristicDecisionV1",
  "type": "object"
