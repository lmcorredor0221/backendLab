        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
