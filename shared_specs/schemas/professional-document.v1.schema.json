{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-agent-builder.local/schemas/professional-document.v1.schema.json",
  "title": "Professional Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "summary", "sections", "traceability_refs"],
  "properties": {
    "schema_version": { "const": "professional-document.v1" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "product": { "enum": ["blueprint", "blueprint_pro", "acp", "enterprise", "unknown"] },
    "stage": { "type": "string" },
    "status": { "type": "string" },
    "generated_at": { "type": "string" },
    "summary": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "unit": { "type": "string" },
          "source_ref": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["columns", "rows"],
              "properties": {
                "columns": { "type": "array", "items": { "type": "string" } },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "calls_to_action": { "type": "array", "items": { "type": "string" } },
    "traceability_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
