          "title": "Type",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "product": {
          "enum": [
            "blueprint",
            "acp",
            "commercial"
          ],
          "title": "Product",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/AttentionSourceRefV2"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "impact": {
          "title": "Impact",
          "type": "string"
        },
        "consequence_if_unresolved": {
          "title": "Consequence If Unresolved",
          "type": "string"
