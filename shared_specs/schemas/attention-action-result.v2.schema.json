        "suggested_answer": {
          "default": "",
          "title": "Suggested Answer",
          "type": "string"
        },
        "unblocks": {
          "default": "",
          "title": "Unblocks",
          "type": "string"
        },
        "resume_action": {
          "default": "",
          "title": "Resume Action",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/AttentionActionV2"
