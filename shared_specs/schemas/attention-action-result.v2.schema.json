        "detected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detected At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "key",
        "type",
        "severity",
        "blocking",
        "product",
        "stage",
        "source",
        "title",
        "reason",
        "impact",
        "consequence_if_unresolved",
        "action"
