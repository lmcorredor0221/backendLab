        "return_href": {
          "title": "Return Href",
          "type": "string"
        },
        "can_resolve_inline": {
          "default": false,
          "title": "Can Resolve Inline",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "label",
        "href",
        "return_href"
      ],
      "title": "AttentionActionV2",
      "type": "object"
    },
    "AttentionDiagnosticsV2": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "technical_message": {
          "default": "",
          "title": "Technical Message",
          "type": "string"
        },
        "error_kind": {
          "default": "",
          "title": "Error Kind",
          "type": "string"
        },
        "capability": {
          "default": "",
          "title": "Capability",
          "type": "string"
        },
        "capability_label": {
          "default": "",
          "title": "Capability Label",
          "type": "string"
        },
        "operation_id": {
          "default": "",
          "title": "Operation Id",
          "type": "string"
        },
        "retry_policy": {
          "default": "",
          "title": "Retry Policy",
          "type": "string"
        },
        "repair_hint": {
          "default": "",
          "title": "Repair Hint",
          "type": "string"
        },
        "trace_refs": {
          "items": {
            "type": "string"
