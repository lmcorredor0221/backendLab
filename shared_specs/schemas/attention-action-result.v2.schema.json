  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "attention-action.v2",
      "default": "attention-action.v2",
      "title": "Contract Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "item_key": {
      "title": "Item Key",
      "type": "string"
    },
    "action_kind": {
      "title": "Action Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "applied",
        "duplicate",
        "unsupported",
        "not_found",
        "conflict",
        "forbidden"
