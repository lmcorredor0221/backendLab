          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "current_stage": {
          "default": "",
          "title": "Current Stage",
          "type": "string"
        },
        "total_count": {
          "default": 0,
          "title": "Total Count",
          "type": "integer"
        },
        "actionable_count": {
          "default": 0,
          "title": "Actionable Count",
          "type": "integer"
        },
        "blocking_count": {
          "default": 0,
          "title": "Blocking Count",
          "type": "integer"
        },
        "warning_count": {
          "default": 0,
          "title": "Warning Count",
          "type": "integer"
        },
        "info_count": {
          "default": 0,
          "title": "Info Count",
          "type": "integer"
