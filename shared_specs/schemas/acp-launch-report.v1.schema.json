{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "default": "acp-launch-report.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "detected_ide": {
      "default": "",
      "title": "Detected Ide",
      "type": "string"
    },
    "detected_tool": {
      "default": "",
      "title": "Detected Tool",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "launcher_version": {
      "default": "",
      "title": "Launcher Version",
      "type": "string"
    },
    "report_path": {
      "default": "",
      "title": "Report Path",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "default": "received",
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "session_id",
    "created_at"
  ],
  "title": "LauncherReportResponse",
  "type": "object"
}
