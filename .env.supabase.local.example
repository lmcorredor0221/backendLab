APP_NAME=Lean Agent Builder API
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# If direct Postgres gives you connectivity trouble, switch to the Supavisor session pooler.
# DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
SCHEMA_MANAGEMENT_MODE=alembic
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
RUNTIME_BOOTSTRAP_ENABLED=false
KNOWLEDGE_REPO_AUTOSYNC_ENABLED=false
CORS_ORIGINS=["http://localhost:3200","http://127.0.0.1:3200","https://leanagentbuilder.com","https://www.leanagentbuilder.com"]
COMMERCE_PUBLIC_BASE_URL=http://localhost:3200
LLM_PROVIDER=openai
LLM_MODE=hybrid
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_REASONING=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_REASONING=gpt-5.5
OPENAI_REASONING_EFFORT=low
CODEX_CLI_COMMAND=codex
CODEX_MODEL=gpt-5.5
CODEX_PROFILE=
CODEX_EXECUTABLE=
CODEX_EXEC_MODEL=
CODEX_EXEC_TIMEOUT_MS=150000
CODEX_EXEC_MAX_CONCURRENCY=1
CODEX_RUNNER_ID=local
CODEX_AUTH_MODE=auto
CODEX_EXEC_FALLBACK_MODELS=
AGENT_EXECUTION_BACKEND=provider_native
KNOWLEDGE_ACCESS_BACKEND=workspace_staged
CODEX_PRIMARY_AGENTS=
CODEX_SHADOW_AGENTS=
CODEX_STAGED_AGENTS=
LOCAL_ADMIN_EMAIL=lmcorredor@leanagentbuilder.com
LOCAL_ADMIN_PASSWORD=[YOUR-LOCAL-ADMIN-PASSWORD]
LOCAL_ADMIN_NAME=Lean Builder Admin
AUTH_TOKEN_TTL_HOURS=12
